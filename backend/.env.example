# EthioOffice Backend Environment Configuration

# Server Settings
PROJECT_NAME="EthioOffice API"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL default, SQLite fallback supported)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ethiooffice
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ethiooffice

# File Storage Configuration
STORAGE_ROOT=./storage_data
MAX_UPLOAD_SIZE_MB=500

# Euro-Office / Document Server Integration
EURO_OFFICE_URL=http://localhost:8080
EURO_OFFICE_JWT_SECRET="euro-office-secret-change-in-production"
